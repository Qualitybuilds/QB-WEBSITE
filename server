# ── e-Boekhouden SOAP ─────────────────────────────────────────────────────
_EB_URL    = 'https://soap.e-boekhouden.nl/soap.asmx'
_EB_NS     = 'http://www.e-boekhouden.nl/soap'
_eb_cache  = {'data': None, 'ts': 0}
_eb_lock   = threading.Lock()
_EB_TTL    = 300  # 5 min cache
_eb_fact_cache  = {'data': None, 'ts': 0}
_eb_fact_lock   = threading.Lock()

def _eb_call(action, body):
    envelope = (
        '<?xml version="1.0" encoding="utf-8"?>'
        '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"'
        ' xmlns:tns="' + _EB_NS + '">'
        '<soap:Body>' + body + '</soap:Body>'
        '</soap:Envelope>'
    )
    req = URLRequest(_EB_URL)
    req.add_header('Content-Type', 'text/xml; charset=utf-8')
    req.add_header('SOAPAction', '"' + _EB_NS + '/' + action + '"')
    req.data = envelope.encode('utf-8')
    with urlopen(req, timeout=15) as r:
        return ET.fromstring(r.read().decode('utf-8'))

def _eb_text(el, tag):
    child = el.find('{' + _EB_NS + '}' + tag)
    return child.text if child is not None and child.text else ''

def _eb_num(el, tag):
    child = el.find('{' + _EB_NS + '}' + tag)
    try:
        return float(child.text) if child is not None and child.text else 0.0
    except (ValueError, TypeError):
        return 0.0

def eb_fetch():
    with _eb_lock:
        if _eb_cache['data'] and (time.time() - _eb_cache['ts']) < _EB_TTL:
            return _eb_cache['data']

    cfg_eb  = CFG.get('eboekhouden', {})
    user    = cfg_eb.get('username', '')
    code1   = cfg_eb.get('code1', '')
    code2   = cfg_eb.get('code2', '')

    # 1. Open session
    root = _eb_call('OpenSession',
        '<tns:OpenSession>'
        '<tns:Username>' + user + '</tns:Username>'
        '<tns:SecurityCode1>' + code1 + '</tns:SecurityCode1>'
        '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
        '<tns:Source>QB-Oracle</tns:Source>'
        '</tns:OpenSession>')
    sid_el = root.find('.//{' + _EB_NS + '}SessionID')
    if sid_el is None or not sid_el.text:
        err = root.find('.//{' + _EB_NS + '}LastErrorDescription')
        raise RuntimeError('OpenSession mislukt: ' + (err.text if err is not None else 'onbekend'))
    sid = sid_el.text

    try:
        # 2. GetOpenPosten debiteuren
        root2 = _eb_call('GetOpenPosten',
            '<tns:GetOpenPosten>'
            '<tns:SessionID>' + sid + '</tns:SessionID>'
            '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
            '<tns:OpSoort>Debiteuren</tns:OpSoort>'
            '</tns:GetOpenPosten>')

        posten = []
        open_map = {}
        for p in root2.findall('.//{' + _EB_NS + '}cOpenPost'):
            datum = _eb_text(p, 'MutDatum')[:10]
            fnr   = _eb_text(p, 'MutFactuur')
            op    = _eb_num(p, 'Openstaand')
            posten.append({
                'datum':    datum,
                'factuur':  fnr,
                'rel_code': _eb_text(p, 'RelCode'),
                'relatie':  _eb_text(p, 'RelBedrijf'),
                'bedrag':   _eb_num(p, 'Bedrag'),
                'voldaan':  _eb_num(p, 'Voldaan'),
                'open':     op,
            })
            if fnr:
                open_map[fnr] = op
        posten.sort(key=lambda x: x['datum'], reverse=True)

        # 3. GetFacturen — huidig jaar
        _jaar = datetime.datetime.now().year
        _dvan = str(_jaar) + '-01-01'
        _dtm  = datetime.datetime.now().strftime('%Y-%m-%d')
        root_f = _eb_call('GetFacturen',
            '<tns:GetFacturen>'
            '<tns:SessionID>' + sid + '</tns:SessionID>'
            '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
            '<tns:cFilter>'
            '<tns:Relatiecode></tns:Relatiecode>'
            '<tns:DatumVan>' + _dvan + '</tns:DatumVan>'
            '<tns:DatumTm>' + _dtm + '</tns:DatumTm>'
            '</tns:cFilter>'
            '</tns:GetFacturen>')
        facturen = []
        for f in root_f.findall('.//{' + _EB_NS + '}cFactuurList'):
            nr   = _eb_text(f, 'Factuurnummer')
            excl = _eb_num(f, 'TotaalExclBTW')
            op   = open_map.get(nr, 0.0)
            facturen.append({
                'nr':     nr,
                'rel':    _eb_text(f, 'Relatiecode'),
                'datum':  _eb_text(f, 'Datum')[:10],
                'excl':   round(excl, 2),
                'status': 'open' if nr in open_map else 'betaald',
                'open':   round(op, 2),
            })
        facturen.sort(key=lambda x: x['datum'], reverse=True)

        # 4. Per relatie samenvatting
        per_rel = {}
        for f in facturen:
            r = f['rel']
            if r not in per_rel:
                per_rel[r] = {'rel': r, 'facturen': 0, 'excl': 0.0, 'open': 0.0}
            per_rel[r]['facturen'] += 1
            per_rel[r]['excl']      = round(per_rel[r]['excl'] + f['excl'], 2)
            per_rel[r]['open']      = round(per_rel[r]['open'] + f['open'], 2)
        per_relatie = sorted(per_rel.values(), key=lambda x: -x['excl'])

        totaal_excl    = round(sum(f['excl'] for f in facturen), 2)
        totaal_betaald = round(sum(f['excl'] - f['open'] for f in facturen), 2)

        result = {
            'posten':            posten,
            'totaal_open':       round(sum(p['open'] for p in posten), 2),
            'totaal_bedrag':     round(sum(p['bedrag'] for p in posten), 2),
            'aantal':            len(posten),
            'facturen':          facturen,
            'facturen_count':    len(facturen),
            'per_relatie':       per_relatie,
            'totaal_omzet_excl': totaal_excl,
            'totaal_betaald':    totaal_betaald,
            'bijgewerkt':        datetime.datetime.now().strftime('%d-%m-%Y %H:%M'),
        }
    finally:
        try:
            _eb_call('CloseSession',
                '<tns:CloseSession><tns:SessionID>' + sid + '</tns:SessionID></tns:CloseSession>')
        except Exception:
            pass

    with _eb_lock:
        _eb_cache['data'] = result
        _eb_cache['ts']   = time.time()
    return result


def eb_fetch_facturen(jaar=None):
    """GetFacturen + cross-ref GetOpenPosten voor betaalstatus. Cache 5 min."""
    with _eb_fact_lock:
        if _eb_fact_cache['data'] and (time.time() - _eb_fact_cache['ts']) < _EB_TTL:
            return _eb_fact_cache['data']

    cfg_eb = CFG.get('eboekhouden', {})
    user   = cfg_eb.get('username', '')
    code1  = cfg_eb.get('code1', '')
    code2  = cfg_eb.get('code2', '')

    if jaar is None:
        jaar = datetime.datetime.now().year
    datum_van = str(jaar) + '-01-01'
    datum_tm  = datetime.datetime.now().strftime('%Y-%m-%d')

    # 1. Open session
    root = _eb_call('OpenSession',
        '<tns:OpenSession>'
        '<tns:Username>' + user + '</tns:Username>'
        '<tns:SecurityCode1>' + code1 + '</tns:SecurityCode1>'
        '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
        '<tns:Source>QB-Oracle</tns:Source>'
        '</tns:OpenSession>')
    sid_el = root.find('.//{' + _EB_NS + '}SessionID')
    if sid_el is None or not sid_el.text:
        err = root.find('.//{' + _EB_NS + '}LastErrorDescription')
        raise RuntimeError('OpenSession mislukt: ' + (err.text if err is not None else 'onbekend'))
    sid = sid_el.text

    facturen = []
    open_map = {}  # factuur_nr -> openstaand bedrag

    try:
        # 2a. GetFacturen — alle facturen dit jaar
        root_f = _eb_call('GetFacturen',
            '<tns:GetFacturen>'
            '<tns:SessionID>' + sid + '</tns:SessionID>'
            '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
            '<tns:cFilter>'
            '<tns:Relatiecode></tns:Relatiecode>'
            '<tns:DatumVan>' + datum_van + '</tns:DatumVan>'
            '<tns:DatumTm>' + datum_tm + '</tns:DatumTm>'
            '</tns:cFilter>'
            '</tns:GetFacturen>')

        for f in root_f.findall('.//{' + _EB_NS + '}cFactuurList'):
            nr          = _eb_text(f, 'Factuurnummer')
            rel_code    = _eb_text(f, 'Relatiecode')
            datum       = _eb_text(f, 'Datum')[:10]
            excl        = _eb_num(f, 'TotaalExclBTW')
            btw_bedrag  = _eb_num(f, 'TotaalBTW')
            incl        = _eb_num(f, 'TotaalInclBTW')
            facturen.append({
                'factuur_nr':   nr,
                'rel_code':     rel_code,
                'datum':        datum,
                'excl_btw':     round(excl, 2),
                'btw':          round(btw_bedrag, 2),
                'incl_btw':     round(incl, 2),
                'status':       'onbekend',
                'open':         round(incl, 2),
            })

        # 2b. GetOpenPosten — debiteuren voor betaalstatus
        root_op = _eb_call('GetOpenPosten',
            '<tns:GetOpenPosten>'
            '<tns:SessionID>' + sid + '</tns:SessionID>'
            '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
            '<tns:OpSoort>Debiteuren</tns:OpSoort>'
            '</tns:GetOpenPosten>')

        for p in root_op.findall('.//{' + _EB_NS + '}cOpenPost'):
            fnr = _eb_text(p, 'MutFactuur')
            op  = _eb_num(p, 'Openstaand')
            if fnr:
                open_map[fnr] = op

    finally:
        try:
            _eb_call('CloseSession',
                '<tns:CloseSession><tns:SessionID>' + sid + '</tns:SessionID></tns:CloseSession>')
        except Exception:
            pass

    # 3. Cross-reference betaalstatus
    for f in facturen:
        nr = f['factuur_nr']
        if nr in open_map:
            op = open_map[nr]
            f['open'] = round(op, 2)
            f['status'] = 'open' if op > 0.01 else 'betaald'
        else:
            f['open'] = 0.0
            f['status'] = 'betaald'

    # 4. Groepeer per relatiecode + totalen
    rel_totals = {}
    for f in facturen:
        rc = f['rel_code'] or 'onbekend'
        if rc not in rel_totals:
            rel_totals[rc] = {'rel_code': rc, 'facturen': [], 'totaal_excl': 0.0, 'totaal_incl': 0.0, 'totaal_open': 0.0, 'aantal': 0}
        rel_totals[rc]['facturen'].append(f)
        rel_totals[rc]['totaal_excl']  = round(rel_totals[rc]['totaal_excl']  + f['excl_btw'], 2)
        rel_totals[rc]['totaal_incl']  = round(rel_totals[rc]['totaal_incl']  + f['incl_btw'], 2)
        rel_totals[rc]['totaal_open']  = round(rel_totals[rc]['totaal_open']  + f['open'],     2)
        rel_totals[rc]['aantal']       += 1

    facturen.sort(key=lambda x: x['datum'], reverse=True)

    result = {
        'jaar':             jaar,
        'facturen':         facturen,
        'per_relatie':      list(rel_totals.values()),
        'totaal_excl':      round(sum(f['excl_btw'] for f in facturen), 2),
        'totaal_incl':      round(sum(f['incl_btw'] for f in facturen), 2),
        'totaal_open':      round(sum(f['open'] for f in facturen), 2),
        'aantal':           len(facturen),
        'aantal_betaald':   sum(1 for f in facturen if f['status'] == 'betaald'),
        'bijgewerkt':       datetime.datetime.now().strftime('%d-%m-%Y %H:%M'),
    }

    with _eb_fact_lock:
        _eb_fact_cache['data'] = result
        _eb_fact_cache['ts']   = time.time()
    return result


