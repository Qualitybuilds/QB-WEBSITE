@app.route('/api/team-stats')
def team_stats():
    """Geeft werkelijke + verwachte uren per medewerker (7d / 30d).
    Meerwerk-uren worden apart getoond en NIET meegenomen in verschil-berekening.
    """
    try:
        pending = load_pending()
        today   = datetime.date.today()
        d7      = (today - datetime.timedelta(days=7)).isoformat()
        d30     = (today - datetime.timedelta(days=30)).isoformat()

        # ── 1. Werkelijke uren uit uren_registratie entries ──────────────────
        uren_logs = [e for e in pending if e.get('type') == 'uren_registratie']
        stats = {}
        for entry in uren_logs:
            naam      = entry.get('medewerker', 'Onbekend')
            datum     = entry.get('datum', '')
            uren      = float(entry.get('totaal_uren', 0))
            is_mw     = bool(entry.get('is_meerwerk', False))

            if naam not in stats:
                stats[naam] = {
                    'uren_7d_werkelijk':    0.0,
                    'uren_30d_werkelijk':   0.0,
                    'meerwerk_uren_7d':     0.0,
                    'meerwerk_uren_30d':    0.0,
                    'laatste_datum':        '',
                    'inzendingen':          0,
                }
            s = stats[naam]
            if datum >= d7:
                s['uren_7d_werkelijk'] += uren
                if is_mw:
                    s['meerwerk_uren_7d'] += uren
            if datum >= d30:
                s['uren_30d_werkelijk'] += uren
                if is_mw:
                    s['meerwerk_uren_30d'] += uren
            if datum > s['laatste_datum']:
                s['laatste_datum'] = datum
            s['inzendingen'] += 1

        # ── 1b. Werkelijke uren Bryan + Maurice uit WR PDFs ─────────────────
        # Normtijden uit QB_NORMTIJDEN.json (single source of truth).
        # dakraam_klein_min = minuten per persoon per raam (35)
        # boeideel_min_per_m = minuten TOTAAL per meter (60) → per persoon = /2 = 30
        # Bryan én Maurice werken altijd samen → elk dezelfde uren.
        _nt = _load_normtijden()
        MIN_RAAM_PP  = _nt.get('dakraam_klein_min', 35)        # min/pp/raam
        MIN_BOEI_PP  = _nt.get('boeideel_min_per_m', 60) / 2   # min/pp/m (totaal÷2 personen)

        def _wk_maandag(fn):
            m = re.search(r'WK[_\-]?(\d{1,2})[_\-](\d{4})', fn, re.IGNORECASE)
            if not m:
                return None
            try:
                return datetime.date.fromisocalendar(int(m.group(2)), int(m.group(1)), 1).isoformat()
            except Exception:
                return None

        wr_veld = wr_dakramen_totals()
        if wr_veld.get('beschikbaar') and wr_veld.get('per_week'):
            for wk in wr_veld['per_week']:
                md = _wk_maandag(wk.get('bestand', ''))
                if md is None:
                    continue
                totaal_ramen = (wk.get('klein', 0) + wk.get('middel', 0) + wk.get('groot', 0))
                boei_m = float(wk.get('boei', 0.0))
                if totaal_ramen == 0 and boei_m == 0:
                    continue
                uren_pp = round((totaal_ramen * MIN_RAAM_PP + boei_m * MIN_BOEI_PP) / 60.0, 2)

                uurloon_map = {
                    'Bryan de Vries — Directeur': 65,
                    'Maurice Weller — Timmerman': 50,
                }
                for naam_veld, uurloon in uurloon_map.items():
                    if naam_veld not in stats:
                        stats[naam_veld] = {
                            'uren_7d_werkelijk': 0.0, 'uren_30d_werkelijk': 0.0,
                            'meerwerk_uren_7d': 0.0,  'meerwerk_uren_30d': 0.0,
                            'laatste_datum': '',       'inzendingen': 0,
                            'uurloon': uurloon,
                        }
                    s = stats[naam_veld]
                    s['uurloon'] = uurloon  # altijd up-to-date houden
                    if md >= d7:
                        s['uren_7d_werkelijk']  = round(s['uren_7d_werkelijk']  + uren_pp, 2)
                    if md >= d30:
                        s['uren_30d_werkelijk'] = round(s['uren_30d_werkelijk'] + uren_pp, 2)
                    if md > s.get('laatste_datum', ''):
                        s['laatste_datum'] = md
                    s['inzendingen'] += 1

        # ── 1c. Jordi — 1u admin per week ────────────────────────────────────
        # Jordi werkt 1 uur/week voor financiën/admin. Gestart ~5 maanden geleden.
        jordi_naam = 'Jordi Boverhoff — Financiën'
        jordi_start = datetime.date(2025, 12, 1)
        weken_totaal = max(1, (today - jordi_start).days // 7)
        if jordi_naam not in stats:
            stats[jordi_naam] = {
                'uren_7d_werkelijk': 0.0, 'uren_30d_werkelijk': 0.0,
                'meerwerk_uren_7d': 0.0,  'meerwerk_uren_30d': 0.0,
                'laatste_datum': today.isoformat(), 'inzendingen': weken_totaal,
                'uurloon': 50,
            }
        stats[jordi_naam]['uren_7d_werkelijk']  = 1.0
        stats[jordi_naam]['uren_30d_werkelijk'] = round(30 / 7, 1)   # ~4.3u per maand
        stats[jordi_naam]['uren_totaal_historisch'] = float(weken_totaal)
        stats[jordi_naam]['uurloon'] = 50

        # ── 2. Verwachte uren uit WR PDFs via normtijden ─────────────────────
        wr_data = wr_dakramen_totals()
        verwacht_7d  = None
        verwacht_30d = None

        if wr_data.get('beschikbaar') and wr_data.get('per_week'):
            # Gebruik per_week om WR-weken binnen 7d / 30d te filteren
            # Bestandsnaam format: WK_XX_2026_PURMEREND_WR.pdf
            def wk_datum(fn):
                """Geef maandag van de WR-week als datum-string YYYY-MM-DD."""
                m = re.search(r'WK[_\-]?(\d{1,2})[_\-](\d{4})', fn, re.IGNORECASE)
                if not m:
                    return None
                wk, yr = int(m.group(1)), int(m.group(2))
                try:
                    # ISO week → maandag
                    d = datetime.date.fromisocalendar(yr, wk, 1)
                    return d.isoformat()
                except Exception:
                    return None

            tot_verwacht_7d  = 0.0
            tot_verwacht_30d = 0.0
            cnt_7d = cnt_30d = 0

            for wk in wr_data['per_week']:
                md = wk_datum(wk.get('bestand', ''))
                if md is None:
                    continue
                vu = verwacht_uren_uit_wr(wk)
                if vu is None:
                    continue
                if md >= d7:
                    tot_verwacht_7d  += vu
                    cnt_7d += 1
                if md >= d30:
                    tot_verwacht_30d += vu
                    cnt_30d += 1

            verwacht_7d  = round(tot_verwacht_7d,  2) if cnt_7d  > 0 else 0.0
            verwacht_30d = round(tot_verwacht_30d, 2) if cnt_30d > 0 else 0.0

        # ── 3. Voeg verwacht + verschil toe aan elk team-lid ─────────────────
        # Verdeel verwachte uren evenredig over medewerkers die in die periode actief zijn.
        # Als er maar 1 medewerker is → alles naar die. Bij 2 → 50/50 split.
        actief_7d  = [n for n, s in stats.items() if s['uren_7d_werkelijk'] > 0]
        actief_30d = [n for n, s in stats.items() if s['uren_30d_werkelijk'] > 0]
        n7  = max(len(actief_7d),  1)
        n30 = max(len(actief_30d), 1)

        for naam, s in stats.items():
            # Verwacht
            vw7  = round(verwacht_7d  / n7,  2) if verwacht_7d  is not None and naam in actief_7d  else 0.0
            vw30 = round(verwacht_30d / n30, 2) if verwacht_30d is not None and naam in actief_30d else 0.0

            # Werkelijk excl. meerwerk (eerlijk vergelijken met normtijden)
            werk_ex_mw_7d  = round(s['uren_7d_werkelijk']  - s['meerwerk_uren_7d'],  2)
            werk_ex_mw_30d = round(s['uren_30d_werkelijk'] - s['meerwerk_uren_30d'], 2)

            # Verschil: positief = meer gewerkt dan verwacht (efficiënt of extra)
            vsch7  = round(werk_ex_mw_7d  - vw7,  2) if vw7  > 0 else None
            vsch30 = round(werk_ex_mw_30d - vw30, 2) if vw30 > 0 else None

            # Verschil %
            vsch7_pct  = round(vsch7  / vw7  * 100, 1) if vsch7  is not None and vw7  > 0 else None
            vsch30_pct = round(vsch30 / vw30 * 100, 1) if vsch30 is not None and vw30 > 0 else None

            s['uren_7d_verwacht']      = vw7
            s['uren_30d_verwacht']     = vw30
            s['uren_7d_verschil']      = vsch7
            s['uren_7d_verschil_pct']  = vsch7_pct
            s['uren_30d_verschil']     = vsch30
            s['uren_30d_verschil_pct'] = vsch30_pct

            # Afronden werkelijk voor display
            s['uren_7d_werkelijk']  = round(s['uren_7d_werkelijk'],  2)
            s['uren_30d_werkelijk'] = round(s['uren_30d_werkelijk'], 2)
            s['meerwerk_uren_30d']  = round(s['meerwerk_uren_30d'],  2)

            # Backward compat — oude dashboard-velden
            s['uren_7d']  = s['uren_7d_werkelijk']
            s['uren_30d'] = s['uren_30d_werkelijk']

        return jsonify(stats)
    except Exception as e:
        import traceback; traceback.print_exc()
        return jsonify({'error': str(e)}), 500


