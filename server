@app.route('/api/fotos/<ref>')
def download_fotos_zip(ref):
    """Geeft alle fotos van een inzending als ZIP. QB-DOCS gebruikt dit voor auto-sync naar projectmap."""
    import zipfile, io
    try:
        data = load_pending()
        # load_pending() geeft een list terug (submissions direct op root-niveau)
        submissions = data if isinstance(data, list) else data.get('submissions', [])
        # Match op volledige ID of prefix (ref = eerste 8 chars is genoeg)
        submission = next(
            (s for s in submissions
             if s.get('id', '') == ref or s.get('id', '').startswith(ref)),
            None
        )
        if not submission:
            return jsonify({'error': 'Niet gevonden', 'ref': ref}), 404
        fotos_paden = submission.get('fotos_opgeslagen', [])
        if not fotos_paden:
            return jsonify({'error': 'Geen fotos bij deze inzending'}), 404
        buf = io.BytesIO()
        toegevoegd = 0
        with zipfile.ZipFile(buf, 'w', zipfile.ZIP_DEFLATED) as zf:
            for fpath in fotos_paden:
                if os.path.exists(fpath):
                    zf.write(fpath, os.path.basename(fpath))
                    toegevoegd += 1
        if toegevoegd == 0:
            return jsonify({'error': 'Fotobestanden niet gevonden op schijf'}), 404
        buf.seek(0)
        from flask import send_file as flask_send_file
        return flask_send_file(
            buf,
            mimetype='application/zip',
            as_attachment=True,
            download_name=f'fotos_{ref[:8]}.zip'
        )
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/week/<int:jaar>/<int:wk>')
def week_data(jaar, wk):
    """
    Geeft alle veld-inzendingen voor een ISO-weeknummer terug.
    Gebruikt door QB-DOCS voor automatische WR/UB generatie.

    GET /api/week/2026/19
    """
    import datetime as dt

    try:
        week_start = dt.date.fromisocalendar(jaar, wk, 1)  # maandag
        week_end   = dt.date.fromisocalendar(jaar, wk, 7)  # zondag
    except ValueError as e:
        return jsonify({'error': f'Ongeldig jaar/week: {e}'}), 400

    pending = load_pending()

    # Filter: veld_submissions binnen deze week
    submissions_week = []
    for s in pending:
        if s.get('type') != 'veld_submission':
            continue
        try:
            datum = dt.date.fromisoformat(s.get('datum', ''))
        except ValueError:
            continue
        if week_start <= datum <= week_end:            submissions_week.append(s)

    # Groepeer per project_id -> per datum -> per adres (sommeer dakramen)
    projecten = {}
    for s in submissions_week:
        pid    = s.get('project_id', '0000')
        datum  = s.get('datum', '')
        straat = s.get('adres_straat', '').strip()
        nr     = s.get('adres_huisnummer', '').strip()
        adres_key = (straat + ' ' + nr).strip()

        if pid not in projecten:
            projecten[pid] = {
                'project_id':   pid,
                'project_naam': PROJECT_NAMES.get(pid, pid),
                'adressen': {}
            }

        key = datum + '_' + adres_key
        if key not in projecten[pid]['adressen']:
            projecten[pid]['adressen'][key] = {
                'datum':         datum,
                'straat':        straat,
                'huisnummer':    nr,
                'adres':         adres_key,
                'klein':         0,
                'middel':        0,
                'groot':         0,
                'kit':           0,
                'sloop':         0.0,
                'boei':          0.0,
                'medewerkers':   [],
                'inzending_ids': [],
            }

        entry = projecten[pid]['adressen'][key]
        entry['klein']  += int(s.get('aw_klein',  s.get('klein',  0)) or 0)
        entry['middel'] += int(s.get('aw_middel', s.get('middel', 0)) or 0)
        entry['groot']  += int(s.get('aw_groot',  s.get('groot',  0)) or 0)
        entry['kit']    += int(s.get('aw_kit',    s.get('kit',    0)) or 0)
        entry['sloop']  += float(s.get('aw_sloop', s.get('sloop', 0)) or 0)
        entry['boei']   += float(s.get('aw_boei',  s.get('boei',  0)) or 0)
        entry['inzending_ids'].append(s.get('id', ''))
        med = s.get('medewerker', '')
        if med and med not in entry['medewerkers']:
            entry['medewerkers'].append(med)

    # Meerwerk apart
    meerwerk = []
    for s in submissions_week:
        mw = s.get('meerwerk', {})
        if mw.get('actief'):
            meerwerk.append({
                'id':           s.get('id', ''),
                'datum':        s.get('datum', ''),
                'medewerker':   s.get('medewerker', ''),
                'project_id':   s.get('project_id', '0000'),
                'adres':        (s.get('adres_straat', '') + ' ' + s.get('adres_huisnummer', '')).strip(),
                'omschrijving': s.get('omschrijving', ''),
                'uren':         mw.get('uren', 0),
                'materiaal_omschrijving': mw.get('materiaal_omschrijving', ''),
            })

    # Projecten dict -> gesorteerde lijsten
    projecten_out = {}
    for pid, pdata in projecten.items():
        adressen_sorted = sorted(pdata['adressen'].values(), key=lambda x: (x['datum'], x['adres']))
        projecten_out[pid] = {
            'project_id':   pid,
            'project_naam': pdata['project_naam'],
            'adressen':     adressen_sorted,
            'totaal': {
                'klein':  sum(a['klein']  for a in adressen_sorted),
                'middel': sum(a['middel'] for a in adressen_sorted),
                'groot':  sum(a['groot']  for a in adressen_sorted),
                'kit':    sum(a['kit']    for a in adressen_sorted),
                'sloop':  round(sum(a['sloop'] for a in adressen_sorted), 2),
                'boei':   round(sum(a['boei']  for a in adressen_sorted), 2),
            }
        }

    return jsonify({
        'jaar':               jaar,
        'week':               wk,
        'week_start':         week_start.isoformat(),
        'week_end':           week_end.isoformat(),
        'projecten':          projecten_out,
        'meerwerk':           meerwerk,
        'totaal_inzendingen': len(submissions_week),
    })


