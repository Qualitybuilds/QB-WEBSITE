    for fn, fdir in files:
        text = ''
        try:
            with pdfplumber.open(os.path.join(fdir, fn)) as pdf:
                for p in pdf.pages:
                    text += (p.extract_text() or '')
        except Exception:
            continue
        k, m, g, kit, sl, bo = _parse_wr_text(text)
        bedrag = _parse_wr_bedrag(text)
        jaar = 2025 if fdir == archief_dir else 2026
        label = _wr_week_label(fn)
        per_week.append({
            'bestand': fn, 'week_label': label, 'jaar': jaar,
            'klein': k, 'middel': m, 'groot': g,
            'kit': kit, 'sloop': sl, 'boei': bo,
            'dakramen': k + m + g, 'bedrag': bedrag,
        })
        totals['klein']  += k
        totals['middel'] += m
        totals['groot']  += g
        totals['kit']    += kit
        totals['sloop']  += sl
        totals['boei']   += bo

    dk_totaal = totals['klein'] + totals['middel'] + totals['groot']
    result = {
        'beschikbaar':       True,
        'per_week':          per_week,
        'totaal_klein':      totals['klein'],
        'totaal_middel':     totals['middel'],
        'totaal_groot':      totals['groot'],
        'totaal_kit':        totals['kit'],
        'totaal_sloop':      round(totals['sloop'], 1),
        'totaal_boei':       round(totals['boei'], 1),
        'dakramen_totaal':   dk_totaal,
        'contract_dakramen': _JP_CONTRACT_DAKRAMEN,
        'contract_boei':     _JP_CONTRACT_BOEI,
        'pct_dakramen':      round(dk_totaal / _JP_CONTRACT_DAKRAMEN * 100, 1),
        'pct_boei':          round(totals['boei'] / _JP_CONTRACT_BOEI * 100, 1),
        'bijgewerkt':        datetime.datetime.now().strftime('%d-%m-%Y %H:%M'),
    }
    with _WR_LOCK:
        _WR_CACHE['data'] = result
        _WR_CACHE['ts']   = time.time()
    return result


# ── e-Boekhouden mutaties voor JP Daken (factuurregels) ───────────────────────
_EB_MUT_CACHE = {'data': None, 'ts': 0}
_EB_MUT_LOCK  = threading.Lock()

def eb_jp_mutaties():
    """GetMutaties voor JP Daken — alle boekingsregels dit jaar. Cache 10 min."""
    with _EB_MUT_LOCK:
        if _EB_MUT_CACHE['data'] and (time.time() - _EB_MUT_CACHE['ts']) < 600:
            return _EB_MUT_CACHE['data']

    cfg_eb = CFG.get('eboekhouden', {})
    user   = cfg_eb.get('username', '')
    code1  = cfg_eb.get('code1', '')
    code2  = cfg_eb.get('code2', '')

    root = _eb_call('OpenSession',
        '<tns:OpenSession>'
        '<tns:Username>' + user + '</tns:Username>'
        '<tns:SecurityCode1>' + code1 + '</tns:SecurityCode1>'
        '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
        '<tns:Source>QB-Oracle</tns:Source>'
        '</tns:OpenSession>')
    sid_el = root.find('.//{' + _EB_NS + '}SessionID')
    if sid_el is None or not sid_el.text:
        raise RuntimeError('OpenSession mislukt')
    sid = sid_el.text

    jaar  = datetime.datetime.now().year
    dvan  = str(jaar) + '-01-01'
    dtm   = datetime.datetime.now().strftime('%Y-%m-%d')

    mutaties = []
    try:
        root_m = _eb_call('GetMutaties',
            '<tns:GetMutaties>'
            '<tns:SessionID>' + sid + '</tns:SessionID>'
            '<tns:SecurityCode2>' + code2 + '</tns:SecurityCode2>'
            '<tns:cFilter>'
            '<tns:MutDatumVan>' + dvan + '</tns:MutDatumVan>'
            '<tns:MutDatumTm>' + dtm + '</tns:MutDatumTm>'
            '<tns:Relatiecode></tns:Relatiecode>'
            '</tns:cFilter>'
            '</tns:GetMutaties>')

        for mut in root_m.findall('.//{' + _EB_NS + '}cMutatieList'):
            rel     = _eb_text(mut, 'Relatiecode')
            bedrijf = _eb_text(mut, 'RelBedrijf')
            # Filter: alleen JP Daken (relatie bevat jp/daken/venrooy/rochdale)
            zoek = (rel + ' ' + bedrijf).lower()
            if not any(kw in zoek for kw in ['jp', 'daken', 'venrooy', 'rochdale']):
                continue
            regels = []
            for regel in mut.findall('.//{' + _EB_NS + '}cMutatieListRegel'):
                regels.append({
                    'grootboek':    _eb_text(regel, 'BTegenrekeningCode'),
                    'omschrijving': _eb_text(regel, 'BTegenrekeningOmschrijving'),
                    'btw_code':     _eb_text(regel, 'BtwCode'),
                    'btw_omschr':   _eb_text(regel, 'BtwOmschrijving'),
                    'bedrag':       _eb_num(regel, 'BBedrag'),
                })
            mutaties.append({
                'datum':        _eb_text(mut, 'MutDatum')[:10],
                'factuur_nr':   _eb_text(mut, 'MutFactuur'),
                'omschrijving': _eb_text(mut, 'MutOmschrijving'),
                'rel_code':     rel,
                'bedrijf':      bedrijf,
                'bedrag':       _eb_num(mut, 'MutBedrag'),
                'regels':       regels,
            })
    finally:
        try:
            _eb_call('CloseSession',
                '<tns:CloseSession><tns:SessionID>' + sid + '</tns:SessionID></tns:CloseSession>')
        except Exception:
            pass

    mutaties.sort(key=lambda x: x['datum'], reverse=True)
    result = {
        'mutaties':   mutaties,
        'aantal':     len(mutaties),
        'bijgewerkt': datetime.datetime.now().strftime('%d-%m-%Y %H:%M'),
    }
    with _EB_MUT_LOCK:
        _EB_MUT_CACHE['data'] = result
        _EB_MUT_CACHE['ts']   = time.time()
    return result


