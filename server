        mw_totaal_uren        = request.form.get('mw_totaal_uren', '0')   # form-level uren (nieuw)
        mw_mat_omschr_form    = request.form.get('mw_materiaal', '')       # form-level materiaal (nieuw)
        mw_bedrag             = request.form.get('mw_bedrag', '0')
        mw_materiaal_omschr   = request.form.get('mw_materiaal_omschrijving', '')
        adres_straat          = request.form.get('adres_straat', '')
        adres_huisnummer      = request.form.get('adres_huisnummer', '')
        try:
            aw_klein  = int(request.form.get('klein',  '0') or '0')
            aw_middel = int(request.form.get('middel', '0') or '0')
            aw_groot  = int(request.form.get('groot',  '0') or '0')
            aw_kit    = int(request.form.get('kit',    '0') or '0')
            aw_sloop  = float(request.form.get('sloop','0') or '0')
            aw_boei   = float(request.form.get('boei', '0') or '0')
        except (ValueError, TypeError):
            aw_klein = aw_middel = aw_groot = aw_kit = 0
            aw_sloop = aw_boei = 0.0

        foto_dir       = get_foto_dir(project_id)
        opgeslagen     = []
        ts_prefix      = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')

        # ── Bijschriften uitlezen ─────────────────────────────────────────
        foto_bijschriften = []
        files_raw = request.files.getlist('fotos')
        for i in range(len(files_raw)):
            bijschr = request.form.get(f'foto_bijschrift_{i}', '')
            mw_uren = request.form.get(f'foto_mw_uren_{i}', '')
            mw_mat  = request.form.get(f'foto_mw_mat_{i}', '')
            foto_bijschriften.append({'bijschrift': bijschr, 'mw_uren': mw_uren, 'mw_materiaal': mw_mat})

        # ── Foto's opslaan ────────────────────────────────────────────────
        files = request.files.getlist('fotos')
        for i, file in enumerate(files):
            if file and file.filename:
                ext  = os.path.splitext(secure_filename(file.filename))[1].lower() or '.jpg'
                naam = f'VELD_{ts_prefix}_{medewerker.split()[0].upper()}_{i+1:02d}{ext}'
                pad  = os.path.join(foto_dir, naam)
                file.save(pad)
                opgeslagen.append(pad)
                print(f'[QB] Opgeslagen: {pad}')

        # ── Submission ID ─────────────────────────────────────────────────
        sub_id = str(uuid.uuid4()).replace('-', '')[:16]

        submission = {
            'id':               sub_id,
            'type':             'veld_submission',
            'timestamp':        datetime.datetime.now().isoformat(),
            'medewerker':       medewerker,
            'project_id':       project_id,
            'project_naam':     PROJECT_NAMES.get(project_id, project_id),
            'datum':            datum,
            'omschrijving':     omschrijving,
            'fotos_opgeslagen': opgeslagen,
            'fotos_count':      len(opgeslagen),
            'meerwerk': {
                'actief':                mw_actief,
                'type':                  mw_type,
                'uren':                  mw_totaal_uren,
                'materiaal_omschrijving': mw_mat_omschr_form or mw_materiaal_omschr,
                'bedrag':                mw_bedrag,
            } if mw_actief else {'actief': False},
            'verified':         False,
            'urgent':           mw_actief,
            'adres_straat':     adres_straat,
            'adres_huisnummer': adres_huisnummer,
            'aw_klein':         aw_klein,
            'aw_middel':        aw_middel,
            'aw_groot':         aw_groot,
            'aw_kit':           aw_kit,
            'aw_sloop':         aw_sloop,
            'aw_boei':          aw_boei,
            'foto_bijschriften': foto_bijschriften,
        }

        # ── PENDING_REVIEWS.json updaten ──────────────────────────────────
        pending = load_pending()
        pending.insert(0, submission)
        save_pending(pending)
        print(f'[QB] 📋 Toegevoegd aan PENDING_REVIEWS: {sub_id}')

        # ── E-mail sturen (asynchroon — blokkeert app niet bij SMTP timeout) ──
        threading.Thread(target=stuur_email, args=(submission,), daemon=True).start()

        return jsonify({
            'success':    True,
            'id':         sub_id,
            'fotos':      len(opgeslagen),
            'meerwerk':   mw_actief,
            'project':    PROJECT_NAMES.get(project_id, project_id),
        })

    except Exception as e:
        print(f'[QB] ❌ Upload fout: {e}')
        import traceback; traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500

