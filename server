def _parse_wr_bedrag(text):
    """Extraheer TOTAAL excl. BTW bedrag uit WR PDF text (beide formaten)."""
    matches = re.findall(r'TOTAAL[^€\n]{0,30}€\s*([\d.]+,\d{2})', text, re.IGNORECASE)
    if not matches:
        matches = re.findall(r'€\s*([\d.]+,\d{2})', text)
    if matches:
        amounts = []
        for m in matches:
            try:
                amounts.append(float(m.replace('.', '').replace(',', '.')))
            except Exception:
                pass
        if amounts:
            return round(max(amounts), 2)
    return 0.0


def _wr_week_label(fn):
    """Geef leesbaar weeklabel uit bestandsnaam.
    Nieuw: WK_03_2026_PURMEREND_WR.pdf  → 'WK 03'
    Oud:   WRF20250001_WK02_10012025_PURMEREND.pdf → 'WK 02 (2025)'
    """
    m = re.match(r'WK_(\d+)_(\d{4})_', fn, re.IGNORECASE)
    if m:
        return f"WK {int(m.group(1)):02d}"
    m = re.search(r'_WK(\d+)_', fn, re.IGNORECASE)
    if m:
        return f"WK {int(m.group(1)):02d} (2025)"
    return fn


def _parse_wr_text(text):
    """Extraheer klein/middel/groot/kit/sloop/boei uit WR PDF text.
    Formaat A (oud): 'Klein dakraam (10 x €246,54)' — getal vóór ×
    Formaat B (nieuw): '__ × 10 € 246,54' — getal ná ×
    """
    # Formaat B: integers direct na ×\s in REKENOVERZICHT sectie
    vals_b = re.findall(r'[×x]\s+(\d+)\s', text)
    if vals_b and len(vals_b) >= 4:
        klein  = int(vals_b[0]) if len(vals_b) > 0 else 0
        middel = int(vals_b[1]) if len(vals_b) > 1 else 0
        groot  = int(vals_b[2]) if len(vals_b) > 2 else 0
        kit    = int(vals_b[3]) if len(vals_b) > 3 else 0
        sloop_m = re.search(r'([0-9]+[,\.][0-9]+)\s*uur\s*[×x]', text)
        # Boeideel: twee formaten —
        #   oud: "14,5 m × €188,65"  → getal VOOR ×
        #   nieuw: "× 14,5 m €188,65" → getal NA ×
        boei_m  = re.search(r'[×x]\s+([0-9]+[,\.][0-9]+)\s*m\b', text)
        if not boei_m:
            boei_m = re.search(r'([0-9]+[,\.][0-9]+)\s*m\s*[×x]', text)
        sloop = float(sloop_m.group(1).replace(',', '.')) if sloop_m else 0.0
        boei  = float(boei_m.group(1).replace(',', '.'))  if boei_m  else 0.0
        return klein, middel, groot, kit, sloop, boei
    # Formaat A: getal vóór × tussen haakjes
    def old_n(label):
        m = re.search(label + r'[^(]*\((\d+(?:[,\.]\d+)?)\s*[×x]', text, re.IGNORECASE)
        return float(m.group(1).replace(',', '.')) if m else 0.0
    klein  = int(old_n(r'[Kk]lein'))
    middel = int(old_n(r'[Mm]iddel'))
    groot  = int(old_n(r'[Gg]root'))
    sloop_m = re.search(r'[Ss]loop[^(]*\(([\d,\.]+)\s*uur?\s*[×x]', text, re.IGNORECASE)
    boei_m  = re.search(r'[Bb]oei[^(]*\(([\d,\.]+)\s*m\s*[×x]', text, re.IGNORECASE)
    sloop = float(sloop_m.group(1).replace(',', '.')) if sloop_m else 0.0
    boei  = float(boei_m.group(1).replace(',', '.'))  if boei_m  else 0.0
    return klein, middel, groot, 0, sloop, boei


