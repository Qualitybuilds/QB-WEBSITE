@app.route('/api/alert-action', methods=['POST'])
def alert_action():
    """Verwerkt een alert-actie (gedaan/bezig/skip/reopen) en logt naar ORACLE_LOG.json."""
    try:
        data    = request.get_json(silent=True) or {}
        sub_id  = data.get('sub_id', '')
        action  = data.get('action', '')
        title   = data.get('title', '')
        project = data.get('project', '')
        actor   = data.get('actor', 'Bryan')

        # Update PENDING_REVIEWS.json als sub_id aanwezig
        if sub_id:
            pending = load_pending()
            for item in pending:
                if item.get('id') == sub_id:
                    if action in ('done', 'skip'):
                        item['verified'] = True
                    elif action == 'reopen':
                        item['verified'] = False
                    item['status']      = action
                    item['actioned_at'] = datetime.datetime.now().isoformat()
                    item['actioned_by'] = actor
                    break
            save_pending(pending)
            print(f'[QB] Oracle: {action} → {sub_id[:8]} — {title[:40]}')

        # Append naar ORACLE_LOG.json
        log_path = os.path.join(QB_ROOT, '00_COMPANY_DATA', 'ORACLE_LOG.json')
        try:
            with open(log_path, 'r', encoding='utf-8') as f:
                log = json.load(f)
        except Exception:
            log = []

        log.insert(0, {
            'ts':      datetime.datetime.now().isoformat(),
            'actie':   action,
            'titel':   title,
            'project': project,
            'actor':   actor,
            'sub_id':  sub_id or None,
        })

        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        with open(log_path, 'w', encoding='utf-8') as f:
            json.dump(log, f, indent=2, ensure_ascii=False)

        return jsonify({'success': True, 'log_count': len(log)})

    except Exception as e:
        print(f'[QB] Alert-action fout: {e}')
        return jsonify({'success': False, 'error': str(e)}), 500


