def verwacht_uren_uit_wr(week_data):
    """Bereken verwachte uren op basis van normtijden × WR-aantallen voor één week.

    week_data: dict met keys klein / middel / groot / kit / sloop / boei
    Retourneert float uren (netto productief).
    Meerwerk heeft geen normtijden — niet meenemen.
    """
    nt = _load_normtijden()
    if not nt:
        return None  # normtijden niet beschikbaar

    klein  = week_data.get('klein',  0)
    middel = week_data.get('middel', 0)
    groot  = week_data.get('groot',  0)
    kit    = week_data.get('kit',    0)
    sloop  = week_data.get('sloop',  0.0)   # al in uren op WR
    boei   = week_data.get('boei',   0.0)   # in meters

    minuten = (
        klein  * nt.get('dakraam_klein_min',   35) +
        middel * nt.get('dakraam_middel_min',  38) +
        groot  * nt.get('dakraam_groot_min',   40) +
        kit    * nt.get('kit_min_per_stuk',     5) +
        boei   * nt.get('boeideel_min_per_m', 18.6)
    )
    # Sloop staat al in uren op de WR — standaard 0,25u/dakraam is erin verwerkt
    uren = minuten / 60.0 + float(sloop)
    return round(uren, 2)


