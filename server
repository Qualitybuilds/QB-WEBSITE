@app.route('/health')
def health():
    """Systeem health check — gebruikt door QB dagelijkse check (scheduled task)."""
    import subprocess
    import ssl
    import socket as _socket

    result = {
        'timestamp': datetime.datetime.now().isoformat(),
        'qb_oracle_service': 'unknown',
        'nginx_service':     'unknown',
        'disk_free_gb':      None,
        'disk_used_pct':     None,
        'ssl_expires':       None,
        'ssl_days_left':     None,
        'ssl_error':         None,
    }

    # ── Services ───────────────────────────────────────────────────────────
    for svc, key in [('qb-oracle', 'qb_oracle_service'), ('nginx', 'nginx_service')]:
        try:
            r = subprocess.run(
                ['systemctl', 'is-active', svc],
                capture_output=True, text=True, timeout=5
            )
            result[key] = r.stdout.strip()
        except Exception as e:
            result[key] = f'error: {e}'

    # ── Schijfruimte ───────────────────────────────────────────────────────
    try:
        total, used, free = shutil.disk_usage('/opt/qb-oracle')
        result['disk_free_gb']  = round(free  / (1024 ** 3), 1)
        result['disk_used_pct'] = round(used / total * 100, 1)
    except Exception as e:
        result['disk_error'] = str(e)

    # ══ SSL ══════════════════════════════════════════════════════════════════════
    try:
        ctx = ssl.create_default_context()
        with ctx.wrap_socket(_socket.socket(), server_hostname='app.qualitybuilds.nl') as s:
            s.connect(('app.qualitybuilds.nl', 443))
            cert = s.getpeercert()
            exp = datetime.datetime.strptime(cert['notAfter'], '%b %d %H:%M:%S %Y %Z')
            days_left = (exp - datetime.datetime.utcnow()).days
            result['ssl_expires']   = exp.strftime('%d-%m-%Y')
            result['ssl_days_left'] = days_left
    except Exception as e:
        result['ssl_error'] = str(e)

    return jsonify(result)


